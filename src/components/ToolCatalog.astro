---
import type { HubCatalogSection } from '../data/hubCatalog';

interface Props {
  sections: readonly HubCatalogSection[];
  compact?: boolean;
}

const { sections, compact = false } = Astro.props;
---

<div class:list={['catalog', { 'catalog--compact': compact }]}>
  {
    sections.map((section) => (
      <section class="catalog-section" aria-labelledby={`${section.id}-title`}>
        <header class="catalog-section__header">
          <p class="catalog-section__eyebrow">{section.eyebrow}</p>
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          <p>{section.description}</p>
        </header>

        <ol class="catalog-list">
          {section.items.map((item, index) => (
            <li>
              <a
                class="catalog-item"
                href={item.href}
                rel={item.external ? 'external' : undefined}
              >
                <span class="catalog-item__index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <span class="catalog-item__body">
                  <span class="catalog-item__meta">
                    {item.external ? 'Standalone app' : 'Lifan.dev tool'}
                  </span>
                  <span class="catalog-item__name">{item.name}</span>
                  <span class="catalog-item__description">
                    {item.description}
                  </span>
                  <span class="catalog-item__highlights" aria-label={`${item.name} highlights`}>
                    {item.highlights.map((highlight) => (
                      <span>{highlight}</span>
                    ))}
                  </span>
                </span>

                <span class="catalog-item__action">
                  {item.action}
                  <span aria-hidden="true">{item.external ? '↗' : '→'}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .catalog-section {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
    gap: var(--spacing-12);
    padding-block: var(--spacing-16);
    border-top: var(--border-subtle);
  }

  .catalog--compact .catalog-section {
    padding-block: var(--spacing-12);
  }

  .catalog-section__header {
    align-self: start;
  }

  .catalog-section__eyebrow,
  .catalog-item__meta {
    margin: 0 0 var(--spacing-3);
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .catalog-section__header h2 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-heading);
    line-height: var(--line-height-heading);
  }

  .catalog-section__header > p:last-child {
    max-width: var(--max-width-prose);
    margin: var(--spacing-3) 0 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .catalog-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-subtle);
  }

  .catalog-item {
    display: grid;
    grid-template-columns: var(--spacing-8) minmax(0, 1fr) auto;
    gap: var(--spacing-6);
    align-items: start;
    min-height: var(--spacing-24);
    padding-block: var(--spacing-6);
    color: inherit;
    text-decoration: none;
    border-bottom: var(--border-subtle);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .catalog-item:hover {
    border-color: var(--color-border-default);
    background-color: var(--color-bg-secondary);
  }

  .catalog-item:focus-visible {
    outline: var(--border-width-thick) solid var(--color-accent);
    outline-offset: var(--spacing-1);
  }

  .catalog-item__index {
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-normal);
  }

  .catalog-item__body {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .catalog-item__meta {
    margin-bottom: var(--spacing-2);
  }

  .catalog-item__name {
    color: var(--color-text-primary);
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-heading);
    line-height: var(--line-height-heading);
    transition: color var(--transition-fast);
  }

  .catalog-item:hover .catalog-item__name,
  .catalog-item:focus-visible .catalog-item__name,
  .catalog-item:hover .catalog-item__action,
  .catalog-item:focus-visible .catalog-item__action {
    color: var(--color-accent);
  }

  .catalog-item__description {
    max-width: var(--max-width-prose);
    margin-top: var(--spacing-2);
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: var(--line-height-body);
  }

  .catalog-item__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-top: var(--spacing-4);
  }

  .catalog-item__highlights > span {
    padding: var(--spacing-1) var(--spacing-2);
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-normal);
    border: var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .catalog-item__action {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding-top: var(--spacing-8);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .catalog-item__action > span {
    transition: transform var(--transition-fast);
  }

  .catalog-item:hover .catalog-item__action > span {
    transform: translateX(var(--spacing-1));
  }

  @media (max-width: 768px) {
    .catalog-section {
      grid-template-columns: 1fr;
      gap: var(--spacing-8);
      padding-block: var(--spacing-12);
    }

    .catalog-item {
      grid-template-columns: var(--spacing-8) minmax(0, 1fr);
      gap: var(--spacing-4);
    }

    .catalog-item__action {
      grid-column: 2;
      padding-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-item,
    .catalog-item__name,
    .catalog-item__action,
    .catalog-item__action > span {
      transition: none;
    }
  }
</style>
