---
import Layout from '../layouts/Layout.astro';

interface ChangelogEntry {
	date: string;
	title: string;
	tags: string[];
	items: string[];
}

const entries: ChangelogEntry[] = [
	{
		date: '2026-06-14',
		title: 'A more active learning experience',
		tags: ['Philosophy', 'Accounting'],
		items: [
			'Lessons now track your position section-by-section, with a progress rail you can click to jump between beats.',
			'Navigate between sections with the J / K keys for a focused, paced reading rhythm.',
			'Inline "quick checks" are interleaved through lessons so you recall as you read, not just at the end.',
			'An interactive "River of Change" demo brings the Heraclitus vs. Parmenides debate to life in Module 1.',
			'The home page now shows a "Continue where you left off" card with per-course progress.',
		],
	},
	{
		date: '2026-05-01',
		title: 'Agent Engineering Lab',
		tags: ['Agent Lab'],
		items: [
			'Twelve focused labs on production AI agent engineering: messages, schemas, tools, the loop, retrieval, MCP, evals, approvals, and operations.',
		],
	},
	{
		date: '2026-03-15',
		title: 'Accounting & Philosophy foundations',
		tags: ['Philosophy', 'Accounting'],
		items: [
			'Launched the Accounting Fundamentals course with interactive calculators, simulators, and visualizers.',
			'Launched the Introduction to Philosophy course covering ancient through modern thought.',
		],
	},
];

const tagStyles: Record<string, string> = {
	Philosophy: 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300',
	Accounting: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300',
	'Agent Lab': 'bg-violet-50 text-violet-700 dark:bg-violet-900/30 dark:text-violet-300',
};

const dateFormatter = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<Layout
	title="Changelog | Lifan Dev"
	description="What's new in Lifan Dev — product updates and learning experience improvements."
	ogImage="/og/changelog.svg"
>
	<div class="max-w-3xl mx-auto py-8">
		<header class="mb-12">
			<h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white mb-3">Changelog</h1>
			<p class="text-lg text-slate-600 dark:text-slate-300">
				A running log of new tools, lessons, and improvements across Lifan Dev.
			</p>
		</header>

		<ol class="relative border-l border-slate-200 dark:border-slate-700 ml-3">
			{
				entries.map((entry) => (
					<li class="mb-12 ml-6">
						<span class="absolute left-[-7px] mt-1.5 h-3.5 w-3.5 rounded-full border-2 border-white bg-blue-500 dark:border-slate-900" />
						<time class="block text-sm font-medium text-slate-500 dark:text-slate-400 mb-1">
							{dateFormatter.format(new Date(entry.date))}
						</time>
						<div class="flex flex-wrap items-center gap-2 mb-3">
							<h2 class="text-xl font-bold text-slate-900 dark:text-white">{entry.title}</h2>
							{entry.tags.map((tag) => (
								<span
									class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${tagStyles[tag] ?? 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300'}`}
								>
									{tag}
								</span>
							))}
						</div>
						<ul class="list-disc pl-5 space-y-2 text-slate-700 dark:text-slate-300">
							{entry.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</li>
				))
			}
		</ol>

		<div class="mt-8 pt-8 border-t border-slate-200 dark:border-slate-700">
			<a
				href="/"
				class="inline-flex items-center gap-2 text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors"
			>
				&larr; Back to tools
			</a>
		</div>
	</div>
</Layout>
