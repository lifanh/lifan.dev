---
import ContinueLearning from '../components/ContinueLearning';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lifan Dev - Personal Tools">
	<div class="max-w-4xl mx-auto text-center py-12">
		<h1 class="text-5xl font-bold tracking-tight mb-6 text-slate-900 dark:text-white">
			Welcome to <span class="text-slate-900 dark:text-white">LIFAN DEV</span>
		</h1>
		<p class="text-xl text-slate-600 dark:text-slate-300 mb-10">
			My personal playground for technology experiments, developer tools, and management functions.
		</p>

		<ContinueLearning client:only="react" />

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
			<a href="/tools/economic-sim" class="block p-6 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-blue-400 dark:hover:border-blue-400 transition-colors transition-shadow hover:shadow-lg group">
				<h2 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400">Economic Concept Visualizer &rarr;</h2>
				<p class="text-slate-600 dark:text-slate-400">Interactive simulation of basic economic principles using React Islands.</p>
			</a>

			<a href="/tools/accounting-intro" class="block p-6 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-blue-400 dark:hover:border-blue-400 transition-colors transition-shadow hover:shadow-lg group">
				<h2 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400">Accounting Fundamentals &rarr;</h2>
				<p class="text-slate-600 dark:text-slate-400">Learn accounting from scratch with interactive lessons, calculators, and real-world scenarios.</p>
			</a>

			<a href="/tools/philosophy-intro" class="block p-6 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-blue-400 dark:hover:border-blue-400 transition-colors transition-shadow hover:shadow-lg group">
				<h2 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400">Introduction to Philosophy &rarr;</h2>
				<p class="text-slate-600 dark:text-slate-400">Interactive lessons through the history of philosophy, from the Pre-Socratics onward.</p>
			</a>

			<a href="/tools/agent-lab/labs" class="block p-6 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-blue-400 dark:hover:border-blue-400 transition-colors transition-shadow hover:shadow-lg group">
				<h2 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400">Agent Engineering Lab &rarr;</h2>
				<p class="text-slate-600 dark:text-slate-400">Twelve focused labs on production AI agent engineering: messages, schemas, tools, the loop, retrieval, MCP, evals, approvals, and operations.</p>
				<span class="mt-3 inline-block text-sm font-medium text-blue-700 dark:text-blue-300">Browse all 12 labs &rarr;</span>
			</a>
		</div>
	</div>
</Layout>
