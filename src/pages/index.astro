---
import ContinueLearning from '../components/ContinueLearning';
import ToolCatalog from '../components/ToolCatalog.astro';
import { hubCatalogSections } from '../data/hubCatalog';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Lifan Dev — Tools for curious minds"
  description="A personal workshop for interactive learning, engineering experiments, and useful standalone apps."
>
  <div class="hub-home">
    <section class="hub-hero" aria-labelledby="hub-title">
      <p class="hub-hero__eyebrow">A personal workshop on the web</p>
      <h1 id="hub-title">Learn what matters.<br />Build what helps.</h1>
      <div class="hub-hero__introduction">
        <p>
          Lifan Dev brings together guided courses, engineering labs, and focused apps—made to
          turn curiosity into something you can use.
        </p>
        <div class="hub-hero__actions">
          <a class="btn btn-primary hub-hero__action" href="/tools">Explore all tools</a>
          <a class="btn btn-secondary hub-hero__action" href="/changelog">See what changed</a>
        </div>
      </div>
    </section>

    <ContinueLearning client:only="react" />

    <ToolCatalog sections={hubCatalogSections} compact />
  </div>
</Layout>

<style>
  .hub-home {
    max-width: var(--max-width-lg);
    margin-inline: auto;
    padding-block: var(--spacing-8) var(--spacing-16);
  }

  .hub-hero {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--spacing-12);
    padding-block: var(--spacing-12) var(--spacing-16);
  }

  .hub-hero__eyebrow {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-normal);
    text-transform: uppercase;
  }

  .hub-hero h1 {
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-heading);
    line-height: var(--line-height-heading);
  }

  .hub-hero__introduction {
    align-self: end;
  }

  .hub-hero__introduction > p {
    max-width: var(--max-width-prose);
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
  }

  .hub-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-3);
    margin-top: var(--spacing-6);
  }

  .hub-hero__action {
    min-height: var(--spacing-12);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .hub-home {
      padding-block: var(--spacing-4) var(--spacing-12);
    }

    .hub-hero {
      grid-template-columns: 1fr;
      gap: var(--spacing-6);
      padding-block: var(--spacing-8) var(--spacing-12);
    }

    .hub-hero__eyebrow {
      grid-column: auto;
    }
  }
</style>
